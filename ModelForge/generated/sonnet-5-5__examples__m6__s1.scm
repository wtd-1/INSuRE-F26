(defmacro (hsec z) (hash (cat "hs" z)))
(defmacro (msec z) (hash (cat "ms" (hsec z))))
(defmacro (shk z cr sr) (hash (cat "shts" (hsec z) cr sr)))
(defmacro (chk z cr sr) (hash (cat "chts" (hsec z) cr sr)))
(defmacro (sak z cr sr) (hash (cat "saps" cr sr (msec z))))
(defmacro (cak z cr sr) (hash (cat "caps" cr sr (msec z))))
(defmacro (cert n k ca) (cat n k (enc n k (privk ca))))
(defmacro (tr1 cr gx sr gy s spk ca)
  (cat cr gx sr gy (cert s spk ca)))
(defmacro (tr1s cr gx sr gy s spk ca)
  (cat (tr1 cr gx sr gy s spk ca)
       (enc (hash (tr1 cr gx sr gy s spk ca)) (invk spk))))
(defmacro (sfin z cr gx sr gy s spk ca)
  (hash (cat (hash (cat "fin" (shk z cr sr)))
             (tr1s cr gx sr gy s spk ca))))
(defmacro (tr2 z cr gx sr gy s spk ca)
  (cat (tr1s cr gx sr gy s spk ca)
       (sfin z cr gx sr gy s spk ca)))
(defmacro (m1 cr gx) (cat cr gx))
(defmacro (m2 z cr gx sr gy s spk ca)
  (cat sr gy
       (enc (cert s spk ca)
            (enc (hash (tr1 cr gx sr gy s spk ca)) (invk spk))
            (sfin z cr gx sr gy s spk ca)
            (shk z cr sr))))
(defmacro (m3 z cr gx sr gy s spk ca c cpk)
  (enc (cert c cpk ca)
       (hash (cat (hash (cat "fin" (chk z cr sr)))
                  (tr2 z cr gx sr gy s spk ca)
                  (cert c cpk ca)))
       (chk z cr sr)))

(defprotocol mtls13 diffie-hellman
  (defrole client
    (vars (s c ca name) (cr sr text) (spk cpk akey)
          (request response text) (x rndx) (y expt))
    (trace
     (send (m1 cr (exp (gen) x)))
     (recv (m2 (exp (exp (gen) y) x) cr (exp (gen) x) sr (exp (gen) y)
               s spk ca))
     (send (m3 (exp (exp (gen) y) x) cr (exp (gen) x) sr (exp (gen) y)
               s spk ca c cpk))
     (send (enc request (cak (exp (exp (gen) y) x) cr sr)))
     (recv (enc response (sak (exp (exp (gen) y) x) cr sr))))
    (uniq-gen x))
  (defrole server
    (vars (s c ca name) (cr sr text) (spk cpk akey)
          (request response text) (y rndx) (x expt))
    (trace
     (recv (m1 cr (exp (gen) x)))
     (send (m2 (exp (exp (gen) x) y) cr (exp (gen) x) sr (exp (gen) y)
               s spk ca))
     (recv (m3 (exp (exp (gen) x) y) cr (exp (gen) x) sr (exp (gen) y)
               s spk ca c cpk))
     (recv (enc request (cak (exp (exp (gen) x) y) cr sr)))
     (send (enc response (sak (exp (exp (gen) x) y) cr sr))))
    (uniq-gen y)))
